(defwidget samurai-stiker []
  (overlay
    (image :path "/home/pavel/.config/eww/widgets/samurai-stiker/logo.png"
           :image-width 300
           :image-height 300)
    (box :orientation "v" :space-evenly false :halign "center" :valign "center"
    )
  )
)

(defwindow samurai-stiker
  :monitor 0
  :geometry (geometry
    :x "20px"
    :y "20px"
    :width "300px"
    :height "300px"
    :anchor "top right")
  :stacking "bg"
  :exclusive false
  :windowtype "dock"
  :transparent true
  (samurai-stiker))
