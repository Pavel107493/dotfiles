(defpoll time :interval "1s"
  "date +'%I:%M'")

(defpoll date :interval "60s"
  "date +'%a %d'")

(defwidget clock []
  (overlay
    (image :path "/home/pavel/.config/eww/widgets/clock/oval.svg"
           :image-width 300
           :image-height 300)
    (box :orientation "v" :space-evenly false :halign "center" :valign "center"
      (label :class "clock-time" :text time)
      (label :class "clock-date" :text date)
    )
  )
)

(defwindow clock-window
  :monitor 0
  :geometry (geometry
    :x "20px"
    :y "20px"
    :width "300px"
    :height "300px"
    :anchor "bottom left")
  :stacking "bg"
  :exclusive false
  :windowtype "dock"
  :transparent true
  (clock))
